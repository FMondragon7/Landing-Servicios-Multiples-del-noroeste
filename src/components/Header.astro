---
import { navLinks, site } from '../data/site';
import Icon from './ui/Icon.astro';
---

<header class="header" id="inicio">
	<div class="container container--wide header__inner">
		<a class="brand" href="#inicio">
			<img
				class="brand__logo"
				src={site.logoPrimary}
				alt="Servicios Múltiples del Noroeste"
				width="220"
				height="45"
			/>
			<span class="brand__text">
				<strong>Servicios Múltiples</strong>
				<span>del Noroeste</span>
			</span>
		</a>

		<nav class="nav" aria-label="Navegación principal">
			{
				navLinks.map((link) => (
					<a class="nav__link" href={link.href}>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="header__actions">
			<a class="btn btn--primary header__cta" href="#contacto">
				Contacto
				<Icon name="arrow-diagonal" size={18} />
			</a>
			<button
				class="burger"
				type="button"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<Icon name="menu" size={24} />
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="mobile-menu" hidden>
		<nav class="mobile-menu__nav" aria-label="Navegación móvil">
			{
				navLinks.map((link) => (
					<a class="mobile-menu__link" href={link.href}>
						{link.label}
					</a>
				))
			}
			<a class="btn btn--primary mobile-menu__cta" href="#contacto">
				Contacto
				<Icon name="arrow-diagonal" size={18} />
			</a>
		</nav>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: rgba(249, 249, 249, 0.92);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid transparent;
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		height: var(--header-h);
	}

	.brand {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.brand__logo {
		width: 200px;
		height: auto;
	}

	.brand__text {
		display: none;
		flex-direction: column;
		font-size: 15px;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.brand__text strong {
		font-weight: 800;
	}

	.brand__text span {
		font-size: 11px;
		letter-spacing: 3px;
		color: #6b6b6b;
	}

	.brand.is-fallback .brand__logo {
		display: none;
	}

	.brand.is-fallback .brand__text {
		display: flex;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 40px;
	}

	.nav__link {
		font-family: var(--font-ui);
		font-size: 16px;
		font-weight: 600;
		line-height: 1;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.nav__link:hover {
		color: var(--brand);
		transform: scale(1.05);
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.header__cta {
		padding: 14px 22px;
		transition: transform 0.2s ease;
	}

	.header__cta:hover {
		transform: scale(1.05);
	}

	.burger {
		display: none;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: var(--radius-sm);
		color: var(--text);
	}

	.mobile-menu {
		border-top: 1px solid #e8e8e8;
		background: var(--bg);
	}

	.mobile-menu__nav {
		display: grid;
		gap: 4px;
		padding: 20px var(--gutter) 28px;
	}

	.mobile-menu__link {
		padding: 12px 0;
		font-family: var(--font-ui);
		font-size: 18px;
		font-weight: 600;
	}

	.mobile-menu__cta {
		margin-top: 12px;
	}

	@media (max-width: 900px) {
		.nav,
		.header__cta {
			display: none;
		}

		.burger {
			display: grid;
		}
	}
</style>

<script>
	const brand = document.querySelector<HTMLElement>('.brand');
	const logo = document.querySelector<HTMLImageElement>('.brand__logo');

	if (brand && logo) {
		logo.addEventListener('error', () => brand.classList.add('is-fallback'));
		if (logo.complete && logo.naturalWidth === 0) brand.classList.add('is-fallback');
	}

	brand.addEventListener('click', (e) => {
		e.preventDefault();
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

	const burger = document.querySelector<HTMLButtonElement>('.burger');
	const mobileMenu = document.querySelector<Element>('#mobile-menu');

	burger?.addEventListener('click', () => {
		const isOpen = burger.getAttribute('aria-expanded') === 'true';
		burger.setAttribute('aria-expanded', String(!isOpen));
		burger.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
		if (mobileMenu) mobileMenu.hidden = isOpen;
	});

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			burger?.setAttribute('aria-expanded', 'false');
			if (mobileMenu) mobileMenu.hidden = true;
		});
	});
</script>
