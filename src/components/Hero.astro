---
import { hero, site } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="hero">
	<div class="container container--wide">
		<h1 class="hero__title">
			{hero.title} <span class="hero__accent">{hero.titleAccent}</span>
		</h1>
		<p class="hero__subtitle">{hero.subtitle}</p>

		<div class="hero__media">
			<img
				class="hero__image"
				src={hero.image}
				alt="Obra en ejecución de Servicios Múltiples del Noroeste"
				width="1400"
				height="700"
				fetchpriority="high"
			/>
		</div>
	</div>

	<a
		class="hero__whatsapp"
		href={site.whatsapp}
		target="_blank"
		rel="noopener"
		aria-label="Escríbenos por WhatsApp"
	>
		<Icon name="whatsapp" size={30} />
	</a>
</section>

<style>
	.hero {
		position: relative;
		padding-block: 40px 0;
	}

	.hero__title {
		max-width: 70ch;
		font-size: 60px;
		font-weight: 800;
		letter-spacing: 1px;
		line-height: 1;
		font-variation-settings: 'wdth' 96;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.hero__accent {
		color: var(--brand);
	}

	.hero__subtitle {
		margin-top: 28px;
		font-size: 20px;
		line-height: 1.25;
		color: #2D2D2DCC;
		text-transform: uppercase;
	}

	.hero__media {
		margin-top: 56px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--bg-soft);
	}

	.hero__image {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}

	.hero__whatsapp {
		position: absolute;
		right: 28px;
		bottom: 64px;
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: #25d366;
		color: var(--white);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		transition: transform 0.2s ease;
	}

	.hero__whatsapp:hover {
		transform: scale(1.08);
	}

	@media (max-width: 1024px) {
		.hero__title {
			font-size: 44px;
			letter-spacing: -0.9px;
		}

		.hero__subtitle {
			font-size: 18px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 24px;
		}

		.hero__title {
			font-size: 32px;
			letter-spacing: -0.6px;
		}

		.hero__subtitle {
			margin-top: 16px;
			font-size: 16px;
		}

		.hero__media {
			margin-top: 32px;
			border-radius: var(--radius);
		}

		.hero__image {
			aspect-ratio: 4 / 3;
		}

		.hero__whatsapp {
			right: 16px;
			bottom: 40px;
			width: 48px;
			height: 48px;
		}
	}
</style>
