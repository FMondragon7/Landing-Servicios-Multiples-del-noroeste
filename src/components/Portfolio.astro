---
import { portfolio } from '../data/site';
import Icon from './ui/Icon.astro';
import Badge from './ui/Badge.astro';

const items = portfolio.items;
---

<section class="section portfolio" id="portafolio">
	<div class="container portfolio__grid">
		<div class="portfolio__intro">
			<span class="eyebrow">{portfolio.eyebrow}</span>
			<h2 class="section-title">{portfolio.title}</h2>
			<p class="portfolio__lead">{portfolio.lead}</p>

			<div class="portfolio__controls">
				<button class="ctrl ctrl--light" type="button" data-carousel-prev aria-label="Anterior proyecto">
					<Icon name="arrow-left" size={20} />
				</button>
				<button class="ctrl ctrl--dark" type="button" data-carousel-next aria-label="Siguiente proyecto">
					<Icon name="arrow-right" size={20} />
				</button>
			</div>

			<div class="portfolio__progress" data-carousel-progress>
				{
					items.map((_, i) => (
						<span class:list={['progress__bar', { 'is-active': i === 0 }]} />
					))
				}
			</div>
		</div>

		<div class="portfolio__viewport" data-carousel-viewport>
			<ul class="portfolio__track" data-carousel-track>
				{
					items.map((project) => (
						<li class="card" data-card>
							<a
								class="card__trigger"
								href={`#proyecto-${project.slug}`}
								data-open-modal={project.slug}
							>
								<img class="card__image" src={project.cover} alt={project.title} width="394" height="490" loading="lazy" />
								<span class="card__shade" />
								<span class="card__badge">
									<Badge label={project.category} />
								</span>
								<span class="card__arrow">
									<Icon name="arrow-diagonal" size={18} />
								</span>
								<span class="card__title">{project.title}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.portfolio__grid {
		display: grid;
		grid-template-columns: 394px 1fr;
		gap: 24px;
		align-items: start;
	}

	.portfolio__intro {
		display: grid;
		gap: 24px;
		justify-items: start;
		padding-top: 8px;
	}

	.portfolio__lead {
		max-width: 40ch;
		color: rgba(45,45,45,0.8);
		font-size: 16px;
		line-height: 1.5;
	}

	.portfolio__controls {
		display: flex;
		gap: 10px;
		margin-top: 24px;
	}

	.ctrl {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.ctrl--light {
		background: var(--bg-soft);
		color: var(--text);
	}

	.ctrl--light:hover {
		background: #e9e9e9;
	}

	.ctrl--dark {
		background: var(--surface-dark);
		color: var(--white);
	}

	.ctrl--dark:hover {
		background: var(--brand);
		color: var(--text);
	}

	.ctrl:hover {
		transform: translateY(-2px);
	}

	.portfolio__progress {
		display: flex;
		gap: 8px;
		width: 100%;
		max-width: 380px;
		margin-top: 4px;
	}

	.progress__bar {
		flex: 1;
		height: 4px;
		border-radius: 999px;
		background: #e3e3e3;
		transition: background-color 0.25s ease;
	}

	.progress__bar.is-active {
		background: var(--surface-dark);
	}

	.portfolio__viewport {
		overflow: hidden;
		margin-right: calc(var(--gutter) * -1);
	}

	.portfolio__track {
		display: flex;
		gap: 22px;
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.card {
		flex: 0 0 394px;
	}

	.card__trigger {
		position: relative;
		display: block;
		aspect-ratio: 394 / 490;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-soft);
	}

	.card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.card__trigger:hover .card__image {
		transform: scale(1.04);
	}

	.card__shade {
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background: linear-gradient(180deg, transparent, rgba(20, 20, 20, 0.78));
	}

	.card__badge {
		position: absolute;
		top: 20px;
		left: 20px;
	}

	.card__arrow {
		position: absolute;
		top: 20px;
		right: 20px;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(45, 45, 45, 0.55);
		color: var(--white);
		backdrop-filter: blur(4px);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.card__trigger:hover .card__arrow {
		background: var(--brand);
		color: var(--text);
	}

	.card__title {
		position: absolute;
		left: 24px;
		right: 24px;
		bottom: 24px;
		color: var(--white);
		font-size: 20px;
		font-weight: 800;
		letter-spacing: -0.4px;
		line-height: 1.15;
		font-variation-settings: 'wdth' 96;
	}

	@media (max-width: 1024px) {
		.portfolio__grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.portfolio__controls {
			margin-top: 0;
		}

		.portfolio__viewport {
			margin-right: calc(var(--gutter) * -1);
		}

		.card {
			flex-basis: 320px;
		}
	}

	@media (max-width: 640px) {
		.card {
			flex-basis: 78%;
		}

		.card__title {
			font-size: 18px;
			letter-spacing: -0.36px;
		}
	}
</style>

<script>
	const viewport = document.querySelector<HTMLElement>('[data-carousel-viewport]');
	const track = document.querySelector<HTMLElement>('[data-carousel-track]');
	const prevBtn = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
	const nextBtn = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
	const progress = document.querySelector<HTMLElement>('[data-carousel-progress]');

	if (viewport && track) {
		const realCards = Array.from(track.querySelectorAll<HTMLElement>('[data-card]'));
		const total = realCards.length;
		let index = 1;
		let step = 0;

		const measure = () => {
			const first = realCards[0];
			if (!first) return;
			const styles = getComputedStyle(track);
			const gap = parseFloat(styles.columnGap || styles.gap || '0');
			step = first.getBoundingClientRect().width + gap;
		};

		const update = () => {
			track.style.transform = `translate3d(${-(index - 1) * step}px, 0, 0)`;
			const bars = progress?.querySelectorAll<HTMLElement>('.progress__bar');
			bars?.forEach((bar, i) => bar.classList.toggle('is-active', i === (index - 1) % total));
			realCards.forEach((card, i) => {
				card.setAttribute('aria-hidden', String(i !== (index - 1) % total));
			});
		};

		const jump = (newIndex: number) => {
			track.style.transition = 'none';
			index = newIndex;
			update();
			requestAnimationFrame(() => {
				track.style.transition = '';
			});
		};

		const go = (dir: 1 | -1) => {
			index += dir;
			if (index > total) index = total;
			else if (index < 1) index = 1;
			else update();
		};

		prevBtn?.addEventListener('click', () => go(-1));
		nextBtn?.addEventListener('click', () => go(1));

		const onResize = () => {
			measure();
			update();
		};

		measure();
		update();
		window.addEventListener('resize', onResize);
	}
</script>