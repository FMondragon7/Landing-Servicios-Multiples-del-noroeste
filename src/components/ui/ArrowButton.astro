---
import Icon from './Icon.astro';

interface Props {
	direction?: 'left' | 'right' | 'diagonal';
	variant?: 'dark' | 'accent' | 'light' | 'ghost';
	label: string;
	size?: 'sm' | 'md';
	disabled?: boolean;
	class?: string;
}

const {
	direction = 'right',
	variant = 'dark',
	label,
	size = 'md',
	disabled = false,
	class: className,
} = Astro.props;

const iconName =
	direction === 'left'
		? 'arrow-left'
		: direction === 'diagonal'
			? 'arrow-diagonal'
			: 'arrow-right';
---

<button
	type="button"
	class:list={['arrow-btn', `arrow-btn--${variant}`, `arrow-btn--${size}`, className]}
	aria-label={label}
	title={label}
	disabled={disabled}
>
	<Icon name={iconName} size={size === 'sm' ? 18 : 20} />
</button>

<style>
	.arrow-btn {
		display: inline-grid;
		place-items: center;
		border-radius: 12px;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.arrow-btn--md {
		width: 48px;
		height: 48px;
	}

	.arrow-btn--sm {
		width: 40px;
		height: 40px;
		border-radius: 10px;
	}

	.arrow-btn--dark {
		background: var(--surface-dark);
		color: var(--white);
	}

	.arrow-btn--dark:hover {
		background: var(--brand);
		color: var(--text);
	}

	.arrow-btn--accent {
		background: var(--surface-dark);
		color: var(--brand);
	}

	.arrow-btn--accent:hover {
		background: var(--brand);
		color: var(--text);
	}

	.arrow-btn--light {
		background: var(--bg-soft);
		color: var(--text);
	}

	.arrow-btn--light:hover {
		background: var(--surface-dark);
		color: var(--white);
	}

	.arrow-btn--ghost {
		background: rgba(45, 45, 45, 0.55);
		color: var(--white);
		backdrop-filter: blur(4px);
	}

	.arrow-btn--ghost:hover {
		background: var(--brand);
		color: var(--text);
	}

	.arrow-btn:disabled {
		background: var(--bg-soft);
		color: var(--muted);
		cursor: not-allowed;
	}

	.arrow-btn:not(:disabled):hover {
		transform: translateY(-2px);
	}
</style>
