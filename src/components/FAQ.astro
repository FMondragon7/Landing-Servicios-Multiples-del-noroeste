---
import { faq } from '../data/site';
import Icon from './ui/Icon.astro';
---

<section class="section faq" id="dudas">
	<div class="container">
		<div class="faq__head">
			<span class="eyebrow">{faq.eyebrow}</span>
			<h2 class="section-title faq__title">{faq.title}</h2>
			<p class="section-lead">{faq.lead}</p>
		</div>

		<div class="faq__list" data-faq>
			{
				faq.items.map((item, index) => (
					<div class:list={['faq__item', { 'is-open': index === 0 }]}>
						<h3 class="faq__question">
							<button
								class="faq__trigger"
								type="button"
								aria-expanded={index === 0 ? 'true' : 'false'}
								aria-controls={`faq-panel-${index}`}
							>
								<span class="faq__index">{String(index + 1).padStart(2, '0')}.</span>
								<span class="faq__label">{item.question}</span>
								<span class="faq__icon">
									<Icon name="chevron-down" size={20} />
								</span>
							</button>
						</h3>
						<div class="faq__panel" id={`faq-panel-${index}`}>
							<div class="faq__panel-inner">
								<p>{item.answer}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq__head {
		display: grid;
		gap: 16px;
		justify-items: start;
		margin-bottom: 40px;
	}

	.faq__title {
		font-size: 32px;
		letter-spacing: -0.64px;
	}

	.faq__list {
		display: grid;
		gap: 16px;
	}

	.faq__item {
		border-radius: 12px;
		background: var(--white);
		transition: background-color 0.25s ease;
	}

	.faq__question {
		font-size: inherit;
		font-weight: inherit;
		letter-spacing: normal;
	}

	.faq__trigger {
		display: grid;
		grid-template-columns: 56px 1fr auto;
		align-items: center;
		gap: 16px;
		width: 100%;
		padding: 28px 40px;
		text-align: left;
	}

	.faq__index {
		color: #8c8c8c;
		font-size: 16px;
		font-weight: 400;
		letter-spacing: -0.8px;
		transition: color 0.25s ease;
	}

	.faq__label {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.32px;
		line-height: 1.3;
		transition: color 0.25s ease;
	}

	.faq__icon {
		display: grid;
		place-items: center;
		color: var(--text);
		transition:
			transform 0.25s ease,
			color 0.25s ease;
	}

	.faq__panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.3s ease;
	}

	.faq__panel-inner {
		overflow: hidden;
	}

	.faq__panel p {
		max-width: 92ch;
		padding: 0 40px 28px 112px;
		color: #5c5c5c;
		font-size: 16px;
		line-height: 1.5;
	}

	.faq__item.is-open {
		background: var(--surface-dark);
	}

	.faq__item.is-open .faq__index {
		color: var(--muted);
	}

	.faq__item.is-open .faq__label {
		color: var(--brand);
	}

	.faq__item.is-open .faq__icon {
		color: var(--white);
		transform: rotate(180deg);
	}

	.faq__item.is-open .faq__panel p {
		color: rgba(255, 255, 255, 0.78);
	}

	@media (max-width: 640px) {
		.faq__title {
			font-size: 24px;
			letter-spacing: -0.48px;
		}

		.faq__trigger {
			grid-template-columns: 32px 1fr auto;
			gap: 12px;
			padding: 20px 16px;
		}

		.faq__panel p {
			padding: 0 16px 20px 60px;
		}
	}
</style>

<script>
	const faqList = document.querySelector<HTMLElement>('[data-faq]');

	faqList?.querySelectorAll<HTMLElement>('.faq__item').forEach((item) => {
		const trigger = item.querySelector<HTMLButtonElement>('.faq__trigger');
		const panel = item.querySelector<HTMLElement>('.faq__panel');

		trigger?.addEventListener('click', () => {
			const isOpen = item.classList.toggle('is-open');
			trigger.setAttribute('aria-expanded', String(isOpen));
			if (panel) panel.style.gridTemplateRows = isOpen ? '1fr' : '0fr';
		});

		if (item.classList.contains('is-open') && panel) {
			panel.style.gridTemplateRows = '1fr';
		}
	});
</script>
